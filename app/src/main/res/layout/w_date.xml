<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingBottom="6dp">
<TextClock android:id="@+id/month" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="90sp" android:maxLines="1" android:gravity="center" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="28" android:format12Hour="MMMM" android:format24Hour="MMMM" android:textStyle="bold" android:paddingTop="4dp" android:paddingBottom="4dp" android:textColor="#FFFFFF"/>
<TextClock android:id="@+id/day" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="90sp" android:maxLines="1" android:gravity="center" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="47" android:format12Hour="d" android:format24Hour="d" android:textStyle="bold" android:textColor="#222222"/>
<TextClock android:id="@+id/weekday" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="90sp" android:maxLines="1" android:gravity="center" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="25" android:format12Hour="EEEE" android:format24Hour="EEEE" android:textColor="#222222"/>
</LinearLayout></FrameLayout>
